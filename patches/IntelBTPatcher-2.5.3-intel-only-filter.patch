+// Local change: only inspect control requests sent to an Intel Bluetooth controller
+// (idVendor 0x8087, bDeviceClass 0xE0). Every other USB device (e.g. UVCAssistant's
+// camera requests, whose descriptors are not wired) is passed through untouched.
+static bool ibtpIsIntelBluetooth(void *that)
+{
+    auto entry = OSDynamicCast(IORegistryEntry, reinterpret_cast<OSObject *>(that));
+    if (entry == nullptr)
+        return false;
+    auto vendor = OSDynamicCast(OSNumber, entry->getProperty("idVendor"));
+    auto cls = OSDynamicCast(OSNumber, entry->getProperty("bDeviceClass"));
+    return vendor != nullptr && vendor->unsigned32BitValue() == 0x8087 &&
+           cls != nullptr && cls->unsigned32BitValue() == 0xE0;
+}
