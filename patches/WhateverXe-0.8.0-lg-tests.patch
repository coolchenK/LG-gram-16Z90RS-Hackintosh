+"""Extract the LG helper actually compiled into kern_xe.cpp for CPU replay."""
+import re
+
+
+def function(source, name):
+    pattern = (r"static __attribute__\(\(noinline\)\) (?:bool|void|uint32_t|uint64_t) "
+               + re.escape(name) + r"\(.*?\n\}")
+    matches = re.findall(pattern, source, re.S)
+    assert len(matches) == 1, (name, len(matches))
+    return matches[0]
+
+
+def aux_backlight(source):
+    start = source.index("static void *display13AuxPort {};")
+    body = function(source, "display13AuxBacklightSet")
+    end = source.index(body, start) + len(body)
+    return source[start:end]
