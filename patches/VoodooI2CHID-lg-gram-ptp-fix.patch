+void VoodooI2CHIDDevice::applyPTPFeatures() {
+    // Both feature reports carry 2 data bytes (see the report descriptor). setReport() strips the
+    // leading report ID, so pass ID + 2 bytes; a 1-byte payload is silently ignored by the pad.
+    static const UInt8 surface[] = {0x05, 0x03, 0x00};  // Selective Reporting: surface + button switch on
+    static const UInt8 mode[] = {0x03, 0x03, 0x00};     // Input Mode: touchpad
+    const UInt8* reports[] = {surface, mode};
+    ptp_applying = true;
+    for (const UInt8* rep : reports) {
+        IOBufferMemoryDescriptor* md = IOBufferMemoryDescriptor::withBytes(rep, 3, kIODirectionOut);
+        IOReturn r = md ? setReport(md, kIOHIDReportTypeFeature, rep[0]) : kIOReturnNoMemory;
+        OSSafeReleaseNULL(md);
+        IOLog("%s::%s PTP feature %u=0x%02x ret=0x%x\n", getName(), name, rep[0], rep[1], r);
+    }
+    ptp_applying = false;
+    vi2cPtpWrites++;
+}
+
+void VoodooI2CHIDDevice::ptpFixTimerFired(OSObject* owner, IOTimerEventSource* timer) {
+    if (awake)
+        applyPTPFeatures();
+    ptp_fix_count++;
+    if (ptp_fix_count == 1 && ptp_fix_timer)
+        ptp_fix_timer->setTimeoutMS(7000);
+    else if (ptp_fix_count == 2 && ptp_fix_timer)
+        ptp_fix_timer->setTimeoutMS(20000);
+}
+
+IOReturn VoodooI2CHIDDevice::kickPowerOnGated() {
+    return setHIDPowerState(kVoodooI2CStateOn);
+}
+
+IOReturn VoodooI2CHIDDevice::setProperties(OSObject* properties) {
+    OSDictionary* dict = OSDynamicCast(OSDictionary, properties);
+    if (dict && command_gate) {
+        if (dict->getObject("VoodooI2CDiag")) {
+            char buf[320];
+            snprintf(buf, sizeof(buf), "reads=%llu ok=%llu zero=%llu err=%llu oversize=%llu irq=%llu irqBusy=%llu "
+                     "lastSize=%d lastId=0x%02x lastErr=0x%x ptpWrites=%u polling=%d awake=%d",
+                     vi2cReads, vi2cOK, vi2cZero, vi2cErr, vi2cBig, vi2cIrq, vi2cIrqBusy,
+                     vi2cLastSize, vi2cLastId, vi2cLastErr, vi2cPtpWrites, interrupt_simulator ? 1 : 0, awake ? 1 : 0);
+            setProperty("VoodooI2CDiagStats", buf);
+            return kIOReturnSuccess;
+        }
+        if (OSNumber* kick = OSDynamicCast(OSNumber, dict->getObject("VoodooI2CKick"))) {
+            unsigned k = kick->unsigned32BitValue();
+            IOReturn r = kIOReturnUnsupported;
+            if (k == 1)
+                r = command_gate->runAction(OSMemberFunctionCast(IOCommandGate::Action, this, &VoodooI2CHIDDevice::kickPowerOnGated));
+            else if (k == 2)
+                r = resetHIDDevice();
+            IOLog("VoodooI2CHIDKick::%s kick=%u ret=0x%x\n", name, k, r);
+            setProperty("VoodooI2CKickResult", r, 32);
+            return kIOReturnSuccess;
+        }
+        if (OSData* feat = OSDynamicCast(OSData, dict->getObject("VoodooI2CSetFeature"))) {
+            IOReturn r = kIOReturnBadArgument;
+            if (feat->getLength() >= 2) {
+                const UInt8* b = reinterpret_cast<const UInt8*>(feat->getBytesNoCopy());
+                IOBufferMemoryDescriptor* md = IOBufferMemoryDescriptor::withBytes(b, feat->getLength(), kIODirectionOut);
+                if (md) {
+                    r = setReport(md, kIOHIDReportTypeFeature, b[0]);
+                    md->release();
+                }
+                IOLog("VoodooI2CHIDKick::%s setFeature id=%u len=%u ret=0x%x\n", name, b[0], feat->getLength(), r);
+            }
+            setProperty("VoodooI2CKickResult", r, 32);
+            return kIOReturnSuccess;
+        }
+        if (OSNumber* gid = OSDynamicCast(OSNumber, dict->getObject("VoodooI2CGetFeature"))) {
+            UInt8 id = gid->unsigned8BitValue();
+            IOReturn r = kIOReturnNoMemory;
+            IOBufferMemoryDescriptor* md = IOBufferMemoryDescriptor::withCapacity(64, kIODirectionIn);
+            if (md) {
+                md->setLength(64);
+                bzero(md->getBytesNoCopy(), 64);
+                r = getReport(md, kIOHIDReportTypeFeature, id);
+                OSData* data = OSData::withBytes(md->getBytesNoCopy(), (unsigned)md->getLength());
+                if (data) {
+                    setProperty("VoodooI2CLastFeature", data);
+                    data->release();
+                }
+                md->release();
+            }
+            IOLog("VoodooI2CHIDKick::%s getFeature id=%u ret=0x%x\n", name, id, r);
+            setProperty("VoodooI2CKickResult", r, 32);
+            return kIOReturnSuccess;
+        }
+    }
+    return super::setProperties(properties);
+}
