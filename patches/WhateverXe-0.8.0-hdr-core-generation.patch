+// Native 24H232 vnode_attr layout receipt. BSD-3-Clause.
+// Actual kernel CTF: struct vnode_attr, type2272, 53 members, size456.
+// This storage helper performs no filesystem call and must only be used after
+// the exact kernel image identity has been qualified by the caller.
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+namespace XeHDRNativeABI {
+class alignas(8) VnodeAttributes {
+    uint8_t storage[456] {};
+    static constexpr uint64_t Wanted=(1ULL<<7)|(1ULL<<9);
+public:
+    void prepareUidMode() {
+        memset(storage,0,sizeof(storage));
+        const uint64_t active=Wanted;
+        memcpy(storage+8,&active,sizeof(active));
+    }
+    void *data(){return storage;}
+    const void *data()const{return storage;}
+    static constexpr size_t size(){return 456;}
+    bool uidMode(uint32_t &uid,uint16_t &mode)const {
+        uint64_t supported=0;memcpy(&supported,storage,sizeof(supported));
+        if((supported&Wanted)!=Wanted)return false;
+        memcpy(&uid,storage+68,sizeof(uid));
+        memcpy(&mode,storage+76,sizeof(mode));
+        return true;
+    }
+    bool rootOwnedNotWritableByOthers()const {
+        uint32_t uid=~0U;uint16_t mode=0;
+        return uidMode(uid,mode)&&uid==0&&(mode&0022)==0;
+    }
+};
+static_assert(sizeof(VnodeAttributes)==456,"24H232 CTF vnode_attr size");
+static_assert(alignof(VnodeAttributes)==8,"24H232 CTF vnode_attr alignment");
+}
